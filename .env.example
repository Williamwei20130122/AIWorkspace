# 数据库。本地开发默认写 prisma/dev.db；Docker 内由 compose 覆盖为 file:/data/app.db
DATABASE_URL="file:./dev.db"

# 会话签名密钥。生产必须替换为随机长字符串：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# 应用对外端口（Docker 容器内部端口；compose 再映射到宿主机 3100）
PORT=3100

# 首次启动空数据库时是否写入演示数据（1/0）
SEED_ON_START=1
