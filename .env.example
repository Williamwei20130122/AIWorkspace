# 会话签名密钥。生产必须替换为随机长字符串：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# 监听端口（Docker 容器内与宿主机映射都是 3100）
PORT=3100

# SQLite 数据库文件路径
#   本地开发：./server/data/app.db
#   Docker：/data/app.db（由 compose 覆盖）
DATABASE_PATH=./server/data/app.db

# 首次启动空数据库时是否写入演示数据（1/0）
SEED_ON_START=1
